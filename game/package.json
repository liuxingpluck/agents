{
  "name": "ashen-abyss",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:pages": "node scripts/art-manifest.mjs && tsc --noEmit && vite build --outDir ../docs --emptyOutDir && touch ../docs/.nojekyll",
    "e2e": "node tests/e2e/smoke.mjs",
    "art:manifest": "node scripts/art-manifest.mjs",
    "art:prompts": "node scripts/art-prompts.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}